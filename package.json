{
  "name": "testdev-interview-site",
  "type": "module",
  "version": "1.0.0",
  "description": "测试开发面试速成站 - Astro + Starlight",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run format && npm run lint && npm run typecheck && npm run build",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.3",
    "astro": "^6.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.28.0",
    "eslint-plugin-astro": "^1.1.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}