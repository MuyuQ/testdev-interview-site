---
// 首页组件 - 学习控制台
// 按照 WEBSITE_STRUCTURE_AND_FLOW_IMPROVEMENT_RECOMMENDATIONS.md 的 6 区域设计

// 临时数据（后续从 lib/home-page.ts 导入）
const entryLinks = [
  {
    id: 'beginner',
    href: '/beginner-course/',
    title: '我是初学者：从零开始',
    description: '按 7 天路线建立测试开发基础，并完成第一个接口自动化小项目。',
  },
  {
    id: 'interview',
    href: '/roadmap/',
    title: '我有基础：冲刺面试',
    description: '直接进入术语速记、项目表达、场景题和追问链。',
  },
];

const moduleLinks = [
  // 第一层：入门教学层
  { layer: '入门教学层', modules: [
    { href: '/beginner-course/', title: '新手教程', desc: '从零开始的学习路径' },
    { href: '/glossary/', title: '术语体系', desc: '测试开发概念词典' },
    { href: '/roadmap/', title: '学习路线', desc: '时间盒学习规划' },
  ]},
  // 第二层：技术能力层
  { layer: '技术能力层', modules: [
    { href: '/tech/', title: '技术专题', desc: 'Python、Pytest、接口测试等' },
    { href: '/coding/', title: '编码题', desc: '小型工程能力训练' },
    { href: '/practice-template/', title: '练手模板', desc: '可交付练习产物' },
  ]},
  // 第三层：项目和场景层
  { layer: '项目和场景层', modules: [
    { href: '/project/', title: '项目类型', desc: '电商、支付、后台等项目' },
    { href: '/scenario/', title: '场景题', desc: '业务风险和测试设计' },
  ]},
  // 第四层：面试表达层
  { layer: '面试表达层', modules: [
    { href: '/interview-chains/', title: '面试追问链', desc: '连续追问训练' },
    { href: '/ai-learning/', title: 'AI学习指南', desc: 'AI 工具和质量责任' },
  ]},
];
---

<section class="hero-section">
  <h1 class="hero-title">测试开发面试速成站</h1>
  <p class="hero-subtitle">
    帮助用户在短时间内补齐测试开发面试知识，并把知识转化成可表达、可练习、可复盘的面试能力。
  </p>
  <div class="hero-cta">
    <a href={entryLinks[0].href} class="cta-primary">选择学习路径</a>
    <a href="#" id="continue-learning" class="cta-secondary">继续上次学习</a>
  </div>
</section>

<section class="entry-section">
  <h2 class="entry-header">选择你的学习方式</h2>
  <div class="entry-grid">
    {entryLinks.map((entry) => (
      <a href={entry.href} class={`entry-card entry-card-${entry.id}`}>
        <h3>{entry.title}</h3>
        <p>{entry.description}</p>
      </a>
    ))}
  </div>
</section>

<section class="modules-section">
  <h2 class="modules-header">模块地图</h2>
  {moduleLinks.map((layer) => (
    <div class="layer-group">
      <h3 class="layer-title">{layer.layer}</h3>
      <div class="modules-grid">
        {layer.modules.map((module) => (
          <a href={module.href} class="module-card">
            <span class="module-card-title">{module.title}</span>
            <span class="module-card-desc">{module.desc}</span>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  /* 从 home-page-v3.css 导入样式 */
  @import '../styles/home-page-v3.css';
</style>